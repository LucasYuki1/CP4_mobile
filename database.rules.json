{
  "rules": {
    ".read": false,
    ".write": false,

    "groupMembers": {
      "$groupId": {
        ".read": "auth != null && data.child(auth.uid).exists()",
        ".write": false
      }
    },

    "messages": {
      "$conversationId": {
        ".read": "auth != null && (($conversationId.contains('_') && ($conversationId.beginsWith(auth.uid + '_') || $conversationId.endsWith('_' + auth.uid))) || (!$conversationId.contains('_') && root.child('groupMembers').child($conversationId).child(auth.uid).exists()))",
        ".indexOn": ["createdAt"],
        "$messageId": {
          ".write": "auth != null && !data.exists() && newData.exists() && $conversationId !== auth.uid + '_' + auth.uid && (($conversationId.contains('_') && ($conversationId.beginsWith(auth.uid + '_') || $conversationId.endsWith('_' + auth.uid))) || (!$conversationId.contains('_') && root.child('groupMembers').child($conversationId).child(auth.uid).exists()))",
          ".validate": "newData.hasChildren(['conversationType', 'senderId', 'text', 'target', 'createdAt'])",
          "conversationType": {
            ".validate": "($conversationId.contains('_') && newData.val() === 'direct') || (!$conversationId.contains('_') && newData.val() === 'group')"
          },
          "senderId": {
            ".validate": "newData.val() === auth.uid"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
          },
          "target": {
            ".validate": "newData.hasChild('type')",
            "type": {
              ".validate": "newData.val() === 'conversation' || newData.val() === 'member'"
            },
            "memberId": {
              ".validate": "newData.isString() && newData.parent().child('type').val() === 'member' && newData.val() !== auth.uid && (($conversationId.contains('_') && ($conversationId.beginsWith(newData.val() + '_') || $conversationId.endsWith('_' + newData.val()))) || (!$conversationId.contains('_') && root.child('groupMembers').child($conversationId).child(newData.val()).exists()))"
            },
            "$other": { ".validate": false }
          },
          "mentionedUserIds": {
            "$uid": {
              ".validate": "newData.val() === true && $uid !== auth.uid && (($conversationId.contains('_') && ($conversationId.beginsWith($uid + '_') || $conversationId.endsWith('_' + $uid))) || (!$conversationId.contains('_') && root.child('groupMembers').child($conversationId).child($uid).exists()))"
            }
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
