{
  "expo": {
    "name": "Chat Firebase",
    "slug": "chat-balcao",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "chat",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fiap.mobile",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.fiap.cp.mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": ["POST_NOTIFICATIONS"]
    },
    "notification": {
      "androidMode": "default"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#2F6B4F",
          "defaultChannel": "messages"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O app acessa suas fotos para voce escolher a foto de perfil ou do grupo."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c05ffba5-30ef-4ed0-8d11-619cb1d82b89"
      }
    }
  }
}
