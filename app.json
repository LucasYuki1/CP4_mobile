{
  "expo": {
    "name": "Balcao",
    "slug": "chat-balcao",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "chat",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fiap.mobile",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.fiap.cp.mobile",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.537149263592-PREENCHER"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c05ffba5-30ef-4ed0-8d11-619cb1d82b89"
      }
    }
  }
}
