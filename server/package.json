{
  "name": "chat-firebase-api",
  "version": "1.0.0",
  "private": true,
  "description": "API de notificacoes push do chat (Express + Firebase Admin SDK).",
  "main": "dist/app.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "dev": "tsc -p tsconfig.json && node --env-file=.env dist/app.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/services/recipientResolver.test.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "typescript": "5.9"
  }
}
