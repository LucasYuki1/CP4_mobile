rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Id deterministico da conversa individual: uids ordenados unidos por '_'.
    function directId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function sharesDirectConversation(uid) {
      return exists(/databases/$(database)/documents/directConversations/$(directId(request.auth.uid, uid)));
    }

    function isNonEmptyString(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    // ---------------------------------------------------------------- perfis
    // Dados cadastrais: o proprio usuario ou quem tem conversa individual com
    // ele. Compartilhar grupo e verificado pela API (GET /profiles/:uid), pois
    // a regra nao sabe em qual grupo procurar.
    match /users/{uid} {
      allow get: if isSelf(uid) || (signedIn() && sharesDirectConversation(uid));
      allow list: if false;
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'phoneNumber', 'birthDate', 'photoUrl', 'createdAt'])
        && isNonEmptyString(request.resource.data.name, 80)
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.phoneNumber is string
        && request.resource.data.birthDate is string
        && request.resource.data.photoUrl is string
        && request.resource.data.createdAt is int;
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phoneNumber', 'birthDate', 'photoUrl'])
        && isNonEmptyString(request.resource.data.name, 80);
      allow delete: if false;

      // Tokens de push: somente o dono le e escreve. A API usa o Admin SDK.
      match /devices/{deviceId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['token', 'provider', 'platform', 'enabled', 'updatedAt'])
          && isNonEmptyString(request.resource.data.token, 4096)
          && request.resource.data.provider in ['fcm', 'expo']
          && request.resource.data.platform in ['android', 'ios']
          && request.resource.data.enabled is bool
          && request.resource.data.updatedAt is int;
      }
    }

    // Cartao publico (nome e foto) para listar e buscar usuarios.
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['name', 'nameLower', 'photoUrl'])
        && isNonEmptyString(request.resource.data.name, 80)
        && request.resource.data.nameLower is string
        && request.resource.data.photoUrl is string;
      allow delete: if false;
    }

    // ---------------------------------------------------- conversas diretas
    match /directConversations/{conversationId} {
      // get funciona mesmo com o documento inexistente, porque usa o proprio id.
      allow get: if signedIn() && request.auth.uid in conversationId.split('_');
      allow list: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['participantIds', 'createdAt'])
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
        && conversationId == directId(request.resource.data.participantIds[0], request.resource.data.participantIds[1])
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participantIds[0]))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participantIds[1]))
        && request.resource.data.createdAt is int;
      allow update, delete: if false;
    }

    // --------------------------------------------------------------- grupos
    function validGroupShape(data) {
      return data.keys().hasOnly(['name', 'photoUrl', 'ownerId', 'memberIds', 'memberLimit',
          'notificationPolicy', 'notificationUpdatedBy', 'createdAt', 'updatedAt'])
        && isNonEmptyString(data.name, 60)
        && data.photoUrl is string
        && data.memberIds is list
        && data.memberIds.toSet().size() == data.memberIds.size()
        && data.ownerId in data.memberIds
        && data.memberLimit is int
        && data.memberLimit >= 2
        && data.memberLimit <= 50
        // Limite de integrantes: avaliado no commit de cada escrita, o que
        // impede estouro mesmo com adicoes concorrentes.
        && data.memberIds.size() <= data.memberLimit
        && data.notificationPolicy in ['all_group_messages', 'mentioned_members', 'direct_messages_only', 'disabled']
        && data.notificationUpdatedBy is string
        && data.createdAt is int
        && data.updatedAt is int;
    }

    function isGroupOwner() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /groups/{groupId} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.memberIds;

      // Ids automaticos do Firestore nao tem '_' e nao colidem com conversas diretas.
      allow create: if signedIn()
        && !groupId.matches('.*_.*')
        && validGroupShape(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.notificationUpdatedBy == request.auth.uid
        && request.resource.data.memberIds.size() >= 2;

      // Proprietario: gerencia integrantes, limite, nome, foto e politica.
      allow update: if isGroupOwner()
        && validGroupShape(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.memberIds.size() >= 2
        && (request.resource.data.notificationPolicy == resource.data.notificationPolicy
            || request.resource.data.notificationUpdatedBy == request.auth.uid);

      // Integrante comum: pode apenas sair do grupo (remover a si mesmo).
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && request.auth.uid != resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
        && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().difference([request.auth.uid].toSet())
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1;

      allow delete: if isGroupOwner();
    }

    // Controle de idempotencia do push: somente a API (Admin SDK) acessa.
    match /notificationDispatches/{dispatchId} {
      allow read, write: if false;
    }
  }
}
